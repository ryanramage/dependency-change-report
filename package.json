    "test:coverage": "node --test --experimental-test-coverage tests/**/*.test.mjs",
    "lint": "echo 'Add ESLint configuration for linting'",
    "start": "node cli.mjs"
  },
  "keywords": [
    "dependency",
    "changelog",
    "git",
    "npm",
    "analysis"
  ],
